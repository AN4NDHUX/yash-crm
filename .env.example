APP_ENV=production
DATABASE_URL=postgresql://yashcrm:replace-me@localhost:5432/yashcrm
ENABLE_AUTH=true
APP_USERNAME=admin
APP_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
APP_PUBLIC_URL=https://yashcrm-production.up.railway.app
ALLOWED_HOSTS=yashcrm-production.up.railway.app
SEED_DEMO_DATA=false

# Optional but strongly recommended for the owner/Administrator account.
# Use a Base32 TOTP secret from your authenticator provisioning workflow.
YASHCRM_ADMIN_TOTP_SECRET=

# Only trust proxy addresses that are actually in front of Uvicorn.
# The cloud entrypoint defaults to loopback rather than trusting every source.
FORWARDED_ALLOW_IPS=127.0.0.1

# Keep same-origin unless a separately hosted trusted frontend genuinely needs API access.
CORS_ORIGINS=

# Cloud-hosted open-weight AI. Keep the token in the hosting provider's secret store.
YASHCRM_AI_PROVIDER=Hugging Face Inference Providers
YASHCRM_AI_BASE_URL=https://router.huggingface.co/v1
YASHCRM_AI_MODEL=openai/gpt-oss-20b:cheapest
YASHCRM_AI_API_KEY=replace-with-a-fine-grained-hugging-face-token
YASHCRM_AI_TIMEOUT=90
YASHCRM_AI_EXCEPTIONS_ENABLED=false

# Server-side secret used to derive AI CSRF tokens.
# If empty, APP_PASSWORD is used. Rotating either invalidates existing AI tokens.
YASHCRM_CSRF_SECRET=
