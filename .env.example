APP_ENV=production
DATABASE_URL=postgresql://yashcrm:replace-me@localhost:5432/yashcrm
ENABLE_AUTH=true
APP_USERNAME=admin
APP_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
APP_PUBLIC_URL=https://yashcrm-production.up.railway.app
ALLOWED_HOSTS=yashcrm-production.up.railway.app
SEED_DEMO_DATA=false

# Production login uses a password plus a one-time 6-digit code.
# Keep this enabled in production. Development may disable it for local tooling.
YASHCRM_LOGIN_OTP_REQUIRED=true
# Secret used to HMAC one-time login codes before database storage.
# Use a long random value and rotate it only during a planned login-code reset window.
YASHCRM_OTP_SECRET=replace-with-a-long-random-secret

# Configure at least SMTP or Twilio in production so login OTPs can be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Only trust proxy addresses that are actually in front of Uvicorn.
# The cloud entrypoint defaults to loopback rather than trusting every source.
FORWARDED_ALLOW_IPS=127.0.0.1

# Keep same-origin unless a separately hosted trusted frontend genuinely needs API access.
CORS_ORIGINS=

# Optional outbound account notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cloud-hosted open-weight AI. Keep the token in the hosting provider's secret store.
YASHCRM_AI_PROVIDER=Hugging Face Inference Providers
YASHCRM_AI_BASE_URL=https://router.huggingface.co/v1
YASHCRM_AI_MODEL=openai/gpt-oss-20b:cheapest
YASHCRM_AI_API_KEY=replace-with-a-fine-grained-hugging-face-token
YASHCRM_AI_TIMEOUT=90
YASHCRM_AI_EXCEPTIONS_ENABLED=false

# Server-side secret used to derive AI CSRF tokens.
# If empty, APP_PASSWORD is used. Rotating either invalidates existing AI tokens.
YASHCRM_CSRF_SECRET=
